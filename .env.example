# CONSIGLIATO — endpoint del form contatti (Formspree, Basin, Web3Forms...)
# DEVE essere un form creato col TUO account: senza questa variabile il form
# non invia niente da solo, ripiega sull'apertura del client di posta del
# visitatore. Non rimettere qui l'ID arrivato col template: era il form di
# un altro, e i messaggi finivano nella sua casella.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional — WebSocket server URL per le funzionalità realtime
# (cursori live, chat, presenza). Lascia vuoto per disattivarle del tutto.
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Google Analytics
NEXT_PUBLIC_GA_ID=
