# Optional — endpoint del form contatti (Formspree, Basin, ecc.)
# Se non lo imposti viene usato l'endpoint di default nel codice.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional — WebSocket server URL per le funzionalità realtime
# (cursori live, chat, presenza). Lascia vuoto per disattivarle del tutto.
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Google Analytics
NEXT_PUBLIC_GA_ID=
