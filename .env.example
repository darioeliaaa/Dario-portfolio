# OBBLIGATORIA — chiave API di Resend (resend.com), usata dal form contatti.
# Senza, il form risponde con un errore esplicito invece di fingere l'invio.
# Resta solo sul server: non ha il prefisso NEXT_PUBLIC_, quindi il browser
# non la vede mai.
RESEND_API_KEY=

# Opzionale — dove arrivano i messaggi (default: config.contactEmail)
CONTACT_TO_EMAIL=

# Opzionale — mittente delle email. Deve appartenere a un dominio verificato
# su Resend (es. contatti@darioelia.it). Il default onboarding@resend.dev
# funziona senza verificare nulla, ma consegna SOLO all'indirizzo con cui hai
# aperto l'account Resend.
CONTACT_FROM_EMAIL=

# Opzionale — per usare un servizio esterno (Formspree, Basin...) al posto
# della rotta interna /api/contact. Se lo imposti, dev'essere un form creato
# col TUO account. Non rimettere qui l'ID arrivato col template: era il form
# di un altro, e i messaggi finivano nella sua casella.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional — WebSocket server URL per le funzionalità realtime
# (cursori live, chat, presenza). Lascia vuoto per disattivarle del tutto.
NEXT_PUBLIC_WS_URL=

# Optional — Umami analytics
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional — Google Analytics
NEXT_PUBLIC_GA_ID=
